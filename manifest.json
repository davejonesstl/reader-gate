{
  "manifest_version": 3,
  "name": "Reader Gate",
  "version": "0.1.0",
  "description": "Intercepts distracting sites and shows what's waiting in your Readwise Reader library instead.",
  "permissions": ["storage", "webNavigation"],
  "host_permissions": ["https://readwise.io/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Reader Gate settings"
  }
}
